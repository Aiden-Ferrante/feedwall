# Copy to .env (gitignored) and fill in. Read by docker compose and by brain/config.py.
# FreshRSS username (docker compose creates it; the brain logs in as it). Default: feedwall.
# FEEDWALL_USER=feedwall
# Container timezone. Default: UTC.
# FEEDWALL_TZ=UTC
# FreshRSS web login password for FEEDWALL_USER (used when the user is first created).
FRESHRSS_PASSWORD=replace-me
# FreshRSS API password (Google Reader API); the brain logs in with this.
FEEDWALL_API_PASS=replace-me
